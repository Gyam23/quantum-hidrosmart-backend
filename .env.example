# Copie para .env e ajuste os valores
APP_NAME=Quantum HidroSmart API
DEBUG=true

# postgresql+psycopg2://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hidrosmart

# Origens permitidas (frontend Next.js), separadas por virgula
CORS_ORIGINS=http://localhost:3000